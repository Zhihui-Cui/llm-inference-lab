from pathlib import Path

import torch
from torch import nn
from torch.utils.data import DataLoader, TensorDataset


def mse(predictions: torch.Tensor, targets: torch.Tensor) -> torch.Tensor:
    if predictions.shape != targets.shape:
        raise ValueError("预测值与真实值的形状必须一致")
    if predictions.numel() == 0:
        raise ValueError("输入不能为空")
    return ((predictions - targets) ** 2).mean()


def build_model() -> nn.Module:
    """训练和加载时，都使用同样的模型结构。"""
    return nn.Sequential(
        nn.Linear(1, 8),
        nn.ReLU(),
        nn.Linear(8, 1),
    )


def evaluate(model: nn.Module, loader: DataLoader) -> float:
    """按样本数汇总 MSE；本实验每个样本有一个输出。"""
    model.eval()
    total_error = 0.0
    total_samples = 0
    with torch.no_grad():
        for inputs, targets in loader:
            batch_loss = mse(model(inputs), targets)
            count = inputs.shape[0]
            total_error += batch_loss.item() * count
            total_samples += count
    if total_samples == 0:
        raise ValueError("评估数据不能为空")
    return total_error / total_samples


def main() -> None:
    torch.manual_seed(42)

    train_inputs = torch.linspace(-2.0, 2.0, 21).reshape(-1, 1)
    train_targets = train_inputs ** 2
    validation_inputs = torch.tensor([[-1.5], [-0.5], [0.5], [1.5]])
    validation_targets = validation_inputs ** 2

    train_dataset = TensorDataset(train_inputs, train_targets)
    validation_dataset = TensorDataset(validation_inputs, validation_targets)

    # 单独控制训练数据的打乱顺序，避免评估频率影响该顺序。
    shuffle_generator = torch.Generator().manual_seed(42)
    train_loader = DataLoader(
        train_dataset,
        batch_size=2,
        shuffle=True,
        generator=shuffle_generator,
    )
    train_eval_loader = DataLoader(train_dataset, batch_size=2)
    validation_loader = DataLoader(validation_dataset, batch_size=2)

    model = build_model()
    optimizer = torch.optim.SGD(model.parameters(), lr=0.01)
    num_epochs = 1000
    log_interval = 100

    # 正无穷：让第一次有效的验证结果就能成为当前最好成绩。
    best_validation_loss = float("inf")
    best_epoch = 0
    update_count = 0
    best_path = Path(__file__).with_name("mlp_best_weights.pth")

    for epoch in range(num_epochs):
        model.train()
        for inputs, targets in train_loader:
            optimizer.zero_grad()
            predictions = model(inputs)
            loss = mse(predictions, targets)
            loss.backward()
            optimizer.step()
            update_count += 1

        # 每个 epoch 都验证；不需要每次都打印。
        validation_loss = evaluate(model, validation_loader)

        # 成绩变好时，立即把此刻的参数写入文件。
        if validation_loss < best_validation_loss:
            best_validation_loss = validation_loss
            best_epoch = epoch + 1
            torch.save(model.state_dict(), best_path)

        if (epoch + 1) % log_interval == 0:
            train_loss = evaluate(model, train_eval_loader)
            print(
                f"epoch {epoch + 1:4d} | 更新 {update_count:5d} 次 | "
                f"训练 MSE = {train_loss:.6e} | "
                f"验证 MSE = {validation_loss:.6e} | "
                f"最佳 epoch = {best_epoch}"
            )

    last_validation_loss = evaluate(model, validation_loader)

    # 用一个新模型加载最佳参数，不再对它执行训练。
    best_model = build_model()
    saved_state = torch.load(best_path, weights_only=True, map_location="cpu")
    best_model.load_state_dict(saved_state)
    loaded_validation_loss = evaluate(best_model, validation_loader)

    print(f"\n最后一轮验证 MSE：{last_validation_loss:.8e}")
    print(f"最佳轮次：{best_epoch}")
    print(f"记录的最佳验证 MSE：{best_validation_loss:.8e}")
    print(f"重新加载后的验证 MSE：{loaded_validation_loss:.8e}")
    print(f"最佳参数保存位置：{best_path}")

    # 只核对保存与加载是否复现成绩，不把这项检查当作独立测试集评估。
    assert abs(loaded_validation_loss - best_validation_loss) < 1e-7

    print("\n验证输入 | 真实值 | 最后一轮预测 | 最佳模型预测")
    model.eval()
    best_model.eval()
    with torch.no_grad():
        last_predictions = model(validation_inputs)
        best_predictions = best_model(validation_inputs)
    for index in range(len(validation_inputs)):
        print(
            f"{validation_inputs[index].item():8.2f} | "
            f"{validation_targets[index].item():6.3f} | "
            f"{last_predictions[index].item():12.6f} | "
            f"{best_predictions[index].item():12.6f}"
        )


if __name__ == "__main__":
    main()
